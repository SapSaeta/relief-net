# Copy this file to .env and fill it in ONLY on your machine.
#   cp .env.example .env
# .env is in .gitignore. Never paste the key into chat, screenshots or commits.

# Meta Model API key: dev.meta.ai/platform -> API keys -> Create API key
MODEL_API_KEY=

# Usually no need to change this
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Models (Standard mode: Meta does NOT train on your data. Avoid the *-contributor ones)
MODEL_TEXT=muse-spark-1.3
MODEL_SEGMENT=sam-3.1
MODEL_VOICE=muse-voice-transcribe-1.0

# Open weights prize: Muse Spark Open served by Baseten (OpenAI-compatible endpoint).
# Key: baseten.co -> API keys. Local .env only.
OPEN_WEIGHTS_BASE_URL=https://inference.baseten.co/v1
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open-1026

# Spend guard for the paid routes (/api/intake, /api/cases/[id]/request, /api/health).
# In production a missing DEMO_ACCESS_CODE blocks them all (fails closed). Local dev runs without it.
DEMO_ACCESS_CODE=
SPEND_CAP_USD=25
MAX_CALLS_PER_IP_PER_DAY=20

# Coordinator triage provider: baseten (open weights, default) or meta.
COORDINATOR_PROVIDER=baseten
