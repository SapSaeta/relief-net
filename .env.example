# Copy this file to .env and fill it in ONLY on your machine.
#   cp .env.example .env
# .env is in .gitignore. Never paste the key into chat, screenshots or commits.

# Meta Model API key: dev.meta.ai/platform -> API keys -> Create API key
MODEL_API_KEY=

# Usually no need to change this
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Models (Standard mode: Meta does NOT train on your data. Avoid the *-contributor ones)
MODEL_TEXT=muse-spark-1.3
MODEL_SEGMENT=sam-3.1
MODEL_VOICE=muse-voice-transcribe-1.0

# Later, for the open weights prize (Baseten / Modal). Leave empty for now.
OPEN_WEIGHTS_BASE_URL=
OPEN_WEIGHTS_API_KEY=
OPEN_WEIGHTS_MODEL=meta-models/muse-spark-open-1026
